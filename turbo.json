{
	"$schema": "https://turbo.build/schema.json",
	"globalDependencies": ["**/.env.*local"],
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"inputs": ["$TURBO_DEFAULT$", ".env*"],
			"outputs": ["build/**", "dist/**"]
		},
		"//#lint": {},
		"//#lint:fix": {
			"cache": false
		},
		"//#format": {},
		"//#format:fix": {
			"dependsOn": ["//#lint:fix"],
			"cache": false
		},
		"dev": {
			"cache": false,
			"persistent": true
		}
	}
}