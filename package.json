{
	"name": "tanstack-turborepo-boilerplate",
	"private": true,
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"build": "turbo build",
		"dev": "turbo dev",
		"lint": "oxlint .",
		"lint:fix": "oxlint --fix .",
		"format": "oxfmt --check",
		"format:fix": "oxfmt .",
		"prepare": "husky"
	},
	"devDependencies": {
		"@repo/typescript-config": "workspace:*",
		"husky": "^9.1.7",
		"lint-staged": "^16.4.0",
		"oxfmt": "^0.50.0",
		"oxlint": "^1.65.0",
		"turbo": "^2.9.6"
	},
	"lint-staged": {
		"*.{js,ts,tsx}": [
			"bun run lint",
			"bun run format"
		]
	},
	"engines": {
		"node": ">=20"
	},
	"packageManager": "bun@1.3.14"
}